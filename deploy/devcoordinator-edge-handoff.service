[Unit]
Description=DevCoordinator temporary first-adoption TLS and route edge
Requires=devcoordinator-edge-handoff-http.socket devcoordinator-edge-handoff-https.socket
After=network-online.target devcoordinator-edge-handoff-http.socket devcoordinator-edge-handoff-https.socket
Wants=network-online.target

[Service]
Type=exec
User=devcoordinator-edge
Group=devcoordinator-edge
Slice=devcoordinator-control.slice
UMask=0077
Environment=DEVCOORDINATOR_ROLE=edge-handoff
LoadCredential=session-secret:/etc/devcoordinator/edge/session-secret
LoadCredential=oidc-client-id:/etc/devcoordinator/edge/google-client-id
LoadCredential=oidc-client-secret:/etc/devcoordinator/edge/google-client-secret
LoadCredential=tls-cert:/etc/letsencrypt/live/vr.ae/fullchain.pem
LoadCredential=tls-key:/etc/letsencrypt/live/vr.ae/privkey.pem
ExecStart=/opt/devcoordinator/releases/RELEASE_DIGEST/bin/devcoordinator-edge --systemd-sockets --route-publication /var/lib/devcoordinator-edge/routes.publication --session-secret-file ${CREDENTIALS_DIRECTORY}/session-secret --oidc-issuer https://accounts.google.com --oidc-client-id-file ${CREDENTIALS_DIRECTORY}/oidc-client-id --oidc-client-secret-file ${CREDENTIALS_DIRECTORY}/oidc-client-secret --tls-cert ${CREDENTIALS_DIRECTORY}/tls-cert --tls-key ${CREDENTIALS_DIRECTORY}/tls-key --identity-state-dir /var/lib/devcoordinator-edge/identity --acme-webroot /var/lib/devcoordinator-edge/acme --release-root /opt/devcoordinator/releases
Restart=always
RestartSec=2
TimeoutStopSec=30s
KillMode=mixed
StateDirectory=devcoordinator-edge
StateDirectoryMode=0700
RuntimeDirectory=devcoordinator-edge-handoff
RuntimeDirectoryMode=0750
StandardOutput=journal
StandardError=journal
SyslogIdentifier=devcoordinator-edge-handoff
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service pkey_alloc pkey_free pkey_mprotect
ReadWritePaths=/var/lib/devcoordinator-edge /run/devcoordinator-edge-handoff
LimitNOFILE=65536
