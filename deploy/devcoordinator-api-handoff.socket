[Unit]
Description=DevCoordinator temporary first-adoption loopback API listener

[Socket]
ListenStream=127.0.0.1:DEVCOORDINATOR_HANDOFF_API_PORT
Accept=no
Service=devcoordinator-api-handoff.service
FileDescriptorName=api
Backlog=256
NoDelay=yes
KeepAlive=yes
RemoveOnStop=no

[Install]
WantedBy=sockets.target
