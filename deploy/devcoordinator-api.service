[Unit]
Description=DevCoordinator trusted loopback API
Requires=devcoordinator-api.socket
After=devcoordinator-api.socket

[Service]
Type=exec
User=devcoordinator-api
Group=devcoordinator-api
Slice=devcoordinator-control.slice
UMask=0077
Environment=DEVCOORDINATOR_ROLE=api
Environment=DEVCOORDINATOR_INVENTORY_PUBLICATION=/var/lib/devcoordinator-observer/inventory.publication
Environment=DEVCOORDINATOR_CALL_LOG=/var/log/devcoordinator/calls.jsonl
Environment=DEVCOORDINATOR_CALL_LOG_MAX_BYTES=4194304
Environment=DEVCOORDINATOR_CALL_LOG_BACKUPS=4
ExecStartPre=/opt/devcoordinator/releases/RELEASE_DIGEST/bin/devcoordinator-profile-check --read-only --profile /etc/devcoordinator/client-profiles.json --expected-schema 2
ExecStart=/opt/devcoordinator/releases/RELEASE_DIGEST/bin/devcoordinator-api --systemd-socket --profile /etc/devcoordinator/client-profiles.json
Restart=always
RestartSec=2
TimeoutStopSec=30s
KillMode=mixed
RuntimeDirectory=devcoordinator-api
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
LogsDirectory=devcoordinator
LogsDirectoryMode=0777
StandardOutput=journal
StandardError=journal
SyslogIdentifier=devcoordinator-api
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
# Repository roots live below /home.  The API only needs read access to
# canonicalize cataloged identities before delegating mutations to the broker.
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/devcoordinator-api
ReadOnlyPaths=/var/lib/devcoordinator-observer

[Install]
WantedBy=multi-user.target
