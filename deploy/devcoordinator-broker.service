[Unit]
Description=DevCoordinator server-wide authority broker
Documentation=file:///home/DevCoordinator/README.md
After=network-online.target docker.service devcoordinator-testd.socket
Wants=network-online.target devcoordinator-testd.socket
SurviveFinalKillSignal=no

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/DevCoordinator
Environment=DEVCOORDINATOR_AUTHORITY=service
Environment=DOCKER_CONFIG=/var/lib/devcoordinator/docker
StateDirectory=devcoordinator
StateDirectoryMode=0711
UMask=0077
ExecStartPre=/usr/bin/python3 -I /home/DevCoordinator/skills/codex-dev-coordinator/scripts/validate_runtime_dependencies.py
ExecStart=/usr/bin/python3 -I /home/DevCoordinator/skills/codex-dev-coordinator/scripts/dev_coordinator.py broker serve --database /var/lib/devcoordinator/coordinator.sqlite3 --socket /run/devcoordinator-authority.sock --socket-mode 0666 --test-plane-socket /run/devcoordinator-testd/testd.sock
Restart=on-failure
RestartSec=2
# Authority admission and committed inventory must remain schedulable while a
# project is CPU-, I/O-, or memory-heavy. Project resources receive no claim on
# this protected control-plane working set.
CPUWeight=10000
IOWeight=10000
MemoryLow=1G
# This 65-minute stop boundary is the broker-side graceful-wait budget plus an
# outer margin. SIGTERM reaches only the broker main process so it can fence
# later mutations and wait within that budget for admitted handlers. This
# configuration alone is not proof that nested Docker or database work has
# reached a terminal state.
KillMode=mixed
KillSignal=SIGTERM
RestartKillSignal=SIGTERM
FinalKillSignal=SIGKILL
SendSIGKILL=yes
TimeoutStopSec=65min
TimeoutStopFailureMode=terminate
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# This single-developer host deliberately gives the authority one global home
# view. Exact path validation and non-root execution constrain repository work;
# local-account home lists are not an authorization boundary.
ProtectHome=false
ReadWritePaths=/home /var/lib/devcoordinator -/run/devcoordinator

[Install]
WantedBy=multi-user.target
